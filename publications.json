---
layout: null
permalink: /publications.json
sitemap: false
---
[
  {%- assign pubs = site.publications | sort: 'date' | reverse -%}
  {%- for p in pubs -%}
  {
    "title": {{ p.title | strip_html | jsonify }},
    "url": "{{ site.url }}{{ site.baseurl }}{{ p.url }}",
    "date": "{{ p.date | date: '%Y-%m-%d' }}",
    "year": {{ p.date | date: '%Y' | jsonify }},
    "venue": {{ p.venue | default: '' | jsonify }},
    "publisher": {{ p.publisher | default: 'IEEE' | jsonify }},
    "doi": {{ p.doi | default: '' | jsonify }},
    "arxiv_id": {{ p.arxiv_id | default: '' | jsonify }},
    "paperurl": {{ p.paperurl | default: '' | jsonify }},
    "authors": {{ p.authors | jsonify }},
    "tldr": {{ p.tldr | default: p.excerpt | strip_html | jsonify }},
    "abstract": {{ p.abstract | default: p.excerpt | strip_html | jsonify }},
    "keywords": {{ p.keywords | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
